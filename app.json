{
  "expo": {
    "name": "Kamba",
    "slug": "kamba",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFDFC",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFDFC"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kamba uses your location to find nearby shops and estimate distance. You can also enter a location manually."
        }
      ]
    ]
  }
}
