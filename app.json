{
  "expo": {
    "name": "Kamba",
    "slug": "kamba",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFDFC",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kamba.ng",
      "adaptiveIcon": {
        "backgroundColor": "#FFFDFC"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kamba uses your location to find nearby shops and estimate distance. You can also enter a location manually."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Kamba uses your camera to capture delivery pickup and handover evidence.",
          "photosPermission": "Kamba uses photos to attach delivery evidence when camera capture is unavailable.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a07a76f-4cce-4c3a-b4c5-07e77b110c35"
      }
    },
    "owner": "kamba-global"
  }
}
